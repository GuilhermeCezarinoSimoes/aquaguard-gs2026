# Configuração da infraestrutura AquaGuard (copiada para /etc/aquaguard/aquaguard.env pelo provisionamento)
# ---------------- Infra (rede/DNS/hostname)
AQG_HOSTNAME=aquaguard-srv01
AQG_DOMINIO=aquaguard.local
# Interface e IP estático (deixe AQG_IP_ESTATICO vazio para manter DHCP — recomendado em VM com NAT)
AQG_INTERFACE=
AQG_IP_ESTATICO=
AQG_GATEWAY=
AQG_DNS_SERVIDORES="1.1.1.1 8.8.8.8"
AQG_TIMEZONE=America/Sao_Paulo

# ---------------- Aplicação
AQG_USUARIO=aquaguard
AQG_DIR_APP=/opt/aquaguard
AQG_DIR_DADOS=/var/lib/aquaguard
AQG_REPO_URL=
AQG_REPO_BRANCH=main
AQG_PORTA_API=5080
ASPNETCORE_ENVIRONMENT=Production
# Chave dos dispositivos IoT (gerada automaticamente se vazia)
AQG_DEVICE_KEY=

# ---------------- Monitoramento
AQG_LIMITE_CPU=80
AQG_LIMITE_MEM=85
AQG_LIMITE_DISCO=85
AQG_INTERVALO_MONITOR=30
AQG_URL_HEALTH=http://127.0.0.1:5080/health
