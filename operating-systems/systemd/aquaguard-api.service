[Unit]
Description=AquaGuard API (ASP.NET Core) - CitizenTech de alagamentos
After=network-online.target
Wants=network-online.target
# Tolerância a falhas: até 10 reinícios em 2 minutos antes de desistir
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=aquaguard
Group=aquaguard
WorkingDirectory=/opt/aquaguard/api
EnvironmentFile=/etc/aquaguard/api.env
ExecStart=/usr/bin/dotnet /opt/aquaguard/api/AquaGuard.Api.dll
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15
SyslogIdentifier=aquaguard-api
# Endurecimento (hardening)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aquaguard
MemoryMax=512M

[Install]
WantedBy=multi-user.target
