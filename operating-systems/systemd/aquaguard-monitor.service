[Unit]
Description=AquaGuard - monitor de infraestrutura (CPU, memoria, disco, API)
After=network-online.target aquaguard-api.service
# Tolerancia a falhas: ate 20 reinicios em 5 minutos antes de desistir
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
ExecStart=/opt/aquaguard-infra/scripts/03_monitor.sh
# Se o processo morrer, for morto (kill -9) ou terminar com erro, o systemd reinicia em 5 s
Restart=always
RestartSec=5
SyslogIdentifier=aquaguard-monitor
Nice=5
RuntimeDirectory=aquaguard-monitor
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
